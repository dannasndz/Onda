// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int             @id @default(autoincrement())
  correo         String          @unique
  nombreUsuario  String          @unique
  contraseña    String
  nombre         String?
  imagenPerfil   String?
  generos        UsuarioGenero[]
  reseñas       Reseña[]
  calificaciones Calificacion[]
}

model Genero {
  id        Int             @id @default(autoincrement())
  nombre    String          @unique
  usuarios  UsuarioGenero[]
  artistas  ArtistaGenero[]
  albums    AlbumGenero[]
  canciones CancionGenero[]
}

model UsuarioGenero {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  generoId  Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  genero    Genero  @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, generoId])
}

model Artista {
  id        Int             @id @default(autoincrement())
  nombre    String
  spotifyId String          @unique
  imagenUrl String?
  generos   ArtistaGenero[]
  albums    Album[]
  canciones Cancion[]
}

model ArtistaGenero {
  id        Int     @id @default(autoincrement())
  artistaId Int
  generoId  Int
  artista   Artista @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  genero    Genero  @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@unique([artistaId, generoId])
}

model Album {
  id               Int            @id @default(autoincrement())
  titulo           String
  spotifyId        String         @unique
  fechaLanzamiento DateTime
  imagenUrl        String?
  tipoAlbum        String
  totalCanciones   Int
  artistaId        Int
  artista          Artista        @relation(fields: [artistaId], references: [id])
  canciones        Cancion[]
  generos          AlbumGenero[]
  reseñas         Reseña[]
  calificaciones   Calificacion[]
}

model AlbumGenero {
  id       Int    @id @default(autoincrement())
  albumId  Int
  generoId Int
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genero   Genero @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@unique([albumId, generoId])
}

model Cancion {
  id             Int             @id @default(autoincrement())
  titulo         String
  spotifyId      String          @unique
  duracionMs     Int
  albumId        Int
  artistaId      Int
  album          Album           @relation(fields: [albumId], references: [id])
  artista        Artista         @relation(fields: [artistaId], references: [id])
  generos        CancionGenero[]
  reseñas       Reseña[]
  calificaciones Calificacion[]
}

model CancionGenero {
  id        Int     @id @default(autoincrement())
  cancionId Int
  generoId  Int
  cancion   Cancion @relation(fields: [cancionId], references: [id], onDelete: Cascade)
  genero    Genero  @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@unique([cancionId, generoId])
}

model Reseña {
  id        Int      @id @default(autoincrement())
  contenido String
  usuarioId Int
  cancionId Int?
  albumId   Int?
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  cancion   Cancion? @relation(fields: [cancionId], references: [id])
  album     Album?   @relation(fields: [albumId], references: [id])

  @@unique([usuarioId, cancionId])
  @@unique([usuarioId, albumId])
}

model Calificacion {
  id        Int      @id @default(autoincrement())
  estrellas Int
  usuarioId Int
  cancionId Int?
  albumId   Int?
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  cancion   Cancion? @relation(fields: [cancionId], references: [id])
  album     Album?   @relation(fields: [albumId], references: [id])

  @@unique([usuarioId, cancionId])
  @@unique([usuarioId, albumId])
}

model TestMusical {
  id         Int    @id @default(autoincrement())
  pregunta   String
  opciones   Json
  respuestas Json
}
