generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int             @id @default(autoincrement())
  correo        String          @unique
  nombreUsuario String          @unique
  contraseña   String
  nombre        String?
  imagenPerfil  String?
  reseñas      Reseña[]
  generos       UsuarioGenero[]
  createdAt     DateTime        @default(now())
}

model Genero {
  id       Int             @id @default(autoincrement())
  nombre   String          @unique
  usuarios UsuarioGenero[]
}

model UsuarioGenero {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  generoId  Int
  tipo      String
  genero    Genero  @relation(fields: [generoId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, generoId, tipo])
}

model Reseña {
  id        String   @id @default(uuid())
  contenido String   @db.VarChar(500)
  album     String?
  artist    String
  coverUrl  String?
  createdAt DateTime @default(now())
  estrellas Int
  genre     String?
  name      String
  tipo      String
  titulo    String
  updatedAt DateTime @updatedAt
  userId    Int
  user      Usuario  @relation(fields: [userId], references: [id])
}

model TestMusical {
  id         Int    @id @default(autoincrement())
  pregunta   String
  opciones   Json
  respuestas Json
}
